<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>FlowCRM | Calculadora de ROI para Automação de Marketing</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    document.documentElement.classList.add("js");
  </script>

  <style>
    :root {
      --pink: #ff4f8b;
      --orange: #ff7a30;
      --ink: #191923;
      --ink-soft: #4f4f5f;
      --white: #ffffff;
      --dark: #111116;
      --gradient: linear-gradient(135deg, var(--pink) 0%, var(--orange) 100%);
      --container: 1180px;
      --radius-lg: 42px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: "Manrope", Arial, sans-serif;
      background: var(--white);
      color: var(--ink);
      overflow-x: hidden;
    }

    img {
      display: block;
      max-width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .gradient-text {
      background: var(--gradient);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      margin-bottom: 24px;
      color: var(--pink);
      font-size: .75rem;
      font-weight: 800;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .section-label::before {
      content: "";
      width: 28px;
      height: 2px;
      border-radius: 999px;
      background: var(--gradient);
    }

    /* Conteúdo visível por padrão.
       Só escondemos para animar quando JS está ativo. */
    .reveal {
      opacity: 1;
      transform: none;
    }

    .js .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity .75s ease,
        transform .75s cubic-bezier(.2,.8,.2,1);
    }

    .js .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .delay-1 { transition-delay: .08s !important; }
    .delay-2 { transition-delay: .16s !important; }
    .delay-3 { transition-delay: .24s !important; }


    /* ==================================================
       NAV
    ================================================== */

    .site-header {
      position: absolute;
      top: 22px;
      left: 0;
      width: 100%;
      z-index: 20;
    }

    .site-nav {
      width: min(1180px, calc(100% - 48px));
      min-height: 66px;
      margin: 0 auto;
      padding: 10px 12px 10px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      border: 1px solid rgba(255,255,255,.72);
      border-radius: 22px;
      background: rgba(255,255,255,.72);
      box-shadow: 0 16px 50px rgba(25,25,35,.07);
      backdrop-filter: blur(18px);
    }

    .logo {
      display: flex;
      align-items: center;
    }

    .logo img {
      width: 142px;
    }


    /* ==================================================
       BUTTONS
    ================================================== */

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 54px;
      padding: 17px 26px;
      border-radius: 999px;
      background: var(--gradient);
      color: #fff;
      font-size: .93rem;
      font-weight: 800;
      box-shadow: 0 16px 38px rgba(255,79,139,.21);
      transition:
        transform .25s ease,
        box-shadow .25s ease;
    }

    .button svg {
      width: 18px;
      height: 18px;
      transition: transform .25s ease;
    }

    .button:hover {
      transform: translateY(-3px);
      box-shadow: 0 24px 54px rgba(255,79,139,.31);
    }

    .button:hover svg {
      transform: translateX(4px);
    }

    .nav-button {
      min-height: 44px;
      padding: 13px 19px;
      font-size: .82rem;
      box-shadow: 0 10px 28px rgba(255,79,139,.18);
    }


    /* ==================================================
       HERO
    ================================================== */

    .hero-section {
      position: relative;
      min-height: 94svh;
      padding: 154px 24px 82px;
      display: flex;
      align-items: center;
      background:
        radial-gradient(circle at 95% 6%, rgba(255,79,139,.16), transparent 32%),
        radial-gradient(circle at 4% 82%, rgba(255,122,48,.08), transparent 28%),
        linear-gradient(180deg, #fff7f3 0%, #ffffff 92%);
      overflow: hidden;
    }

    .hero-section::before {
      content: "";
      position: absolute;
      width: 650px;
      height: 650px;
      top: -340px;
      right: -170px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,79,139,.18), transparent 68%);
      animation: heroOrb 10s ease-in-out infinite alternate;
      pointer-events: none;
    }

    @keyframes heroOrb {
      to {
        transform: translate3d(-30px, 38px, 0) scale(1.07);
      }
    }

    .hero-container {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: var(--container);
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0,1.06fr) minmax(390px,.94fr);
      gap: clamp(54px, 7vw, 90px);
      align-items: center;
    }

    .hero-copy {
      max-width: 675px;
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 9px 13px;
      margin-bottom: 23px;
      border: 1px solid rgba(255,79,139,.13);
      border-radius: 999px;
      background: rgba(255,255,255,.7);
      box-shadow: 0 10px 28px rgba(25,25,35,.045);
      color: #666675;
      font-size: .77rem;
      font-weight: 700;
    }

    .hero-eyebrow::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--pink);
      box-shadow: 0 0 0 5px rgba(255,79,139,.09);
    }

    .hero-copy h1 {
      margin: 0;
      max-width: 700px;
      font-size: clamp(3.35rem, 5.7vw, 5.6rem);
      line-height: .95;
      letter-spacing: -.074em;
    }

    .hero-description {
      margin: 26px 0 0;
      max-width: 570px;
      color: var(--ink-soft);
      font-size: clamp(1.02rem, 1.55vw, 1.14rem);
      line-height: 1.7;
    }

    .hero-actions {
      margin-top: 32px;
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .hero-visual {
      position: relative;
      perspective: 1200px;
    }

    .mockup-stage {
      position: relative;
      padding: 10px;
      border: 1px solid rgba(255,255,255,.9);
      border-radius: 30px;
      background: rgba(255,255,255,.62);
      box-shadow: 0 38px 92px rgba(25,25,35,.15);
      backdrop-filter: blur(20px);
      transform: perspective(1200px) rotateY(-5deg) rotateX(2deg);
      transition: transform .5s cubic-bezier(.2,.8,.2,1);
    }

    .hero-visual:hover .mockup-stage {
      transform: perspective(1200px) rotateY(-1deg) rotateX(0deg) translateY(-6px);
    }

    .mockup-stage img {
      width: 100%;
      border-radius: 22px;
    }

    .mockup-stage::before {
      content: "";
      position: absolute;
      inset: -36px;
      z-index: -1;
      border-radius: 50px;
      background: linear-gradient(135deg, rgba(255,79,139,.17), rgba(255,122,48,.09));
      filter: blur(34px);
      opacity: .72;
    }

    .floating-note {
      position: absolute;
      left: -34px;
      bottom: -28px;
      max-width: 205px;
      padding: 15px 17px;
      border: 1px solid rgba(255,255,255,.84);
      border-radius: 18px;
      background: rgba(255,255,255,.86);
      box-shadow: 0 20px 55px rgba(25,25,35,.11);
      backdrop-filter: blur(16px);
      color: #575765;
      font-size: .78rem;
      line-height: 1.45;
      animation: floatNote 4.5s ease-in-out infinite alternate;
    }

    .floating-note strong {
      display: block;
      margin-bottom: 3px;
      color: var(--ink);
      font-size: .82rem;
    }

    @keyframes floatNote {
      to { transform: translateY(-8px); }
    }


    /* ==================================================
       CHALLENGE
    ================================================== */

    .challenge-section {
      position: relative;
      padding: clamp(78px, 8vw, 104px) 24px clamp(58px, 6vw, 78px);
      background:
        radial-gradient(circle at 8% 22%, rgba(255,79,139,.05), transparent 24%),
        radial-gradient(circle at 92% 70%, rgba(255,122,48,.035), transparent 25%),
        #ffffff;
      overflow: hidden;
    }

    .challenge-number {
      position: absolute;
      top: 12px;
      right: max(24px, calc((100vw - 1180px) / 2));
      color: rgba(25,25,35,.026);
      font-size: clamp(8rem, 17vw, 16rem);
      font-weight: 800;
      line-height: 1;
      letter-spacing: -.08em;
      pointer-events: none;
    }

    .challenge-container {
      position: relative;
      z-index: 2;
      max-width: var(--container);
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0,1.08fr) minmax(390px,.92fr);
      gap: clamp(62px, 8vw, 108px);
      align-items: center;
    }

    .challenge-heading h2 {
      margin: 0;
      max-width: 700px;
      font-size: clamp(3rem, 4.8vw, 4.85rem);
      line-height: .99;
      letter-spacing: -.065em;
    }

    .challenge-content {
      position: relative;
    }

    .challenge-content::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: -31px;
      width: 1px;
      background: linear-gradient(180deg, var(--pink), rgba(255,122,48,.1));
    }

    .challenge-intro {
      margin: 0;
      color: #555563;
      font-size: 1.06rem;
      line-height: 1.78;
    }

    .challenge-conclusion {
      margin: 28px 0 0;
      padding-top: 25px;
      border-top: 1px solid rgba(25,25,35,.08);
      color: var(--ink);
      font-size: 1.02rem;
      font-weight: 700;
      line-height: 1.62;
    }


    /* ==================================================
       BEFORE / AFTER IMAGE
    ================================================== */

    .challenge-visual-wrap {
      position: relative;
      z-index: 3;
      width: min(1240px, calc(100% - 48px));
      margin: clamp(44px, 5vw, 64px) auto 0;
    }

    .challenge-visual-wrap::before {
      content: "";
      position: absolute;
      inset: 10% 6% -5%;
      border-radius: 50px;
      background: linear-gradient(120deg, rgba(255,79,139,.11), rgba(255,122,48,.08));
      filter: blur(42px);
      opacity: .72;
      pointer-events: none;
    }

    .challenge-visual {
      position: relative;
      padding: 9px;
      border: 1px solid rgba(25,25,35,.07);
      border-radius: 32px;
      background: rgba(255,255,255,.86);
      box-shadow: 0 32px 82px rgba(25,25,35,.12);
      overflow: hidden;
      transition:
        transform .45s cubic-bezier(.2,.8,.2,1),
        box-shadow .45s ease;
    }

    .challenge-visual:hover {
      transform: translateY(-5px);
      box-shadow: 0 44px 96px rgba(25,25,35,.16);
    }

    .challenge-visual img {
      width: 100%;
      height: auto;
      border-radius: 24px;
    }


    /* ==================================================
       MOVING BACKGROUND TRANSITION
    ================================================== */

    .section-transition {
      position: relative;
      height: 76px;
      margin-top: -1px;
      background:
        linear-gradient(
          180deg,
          #ffffff 0%,
          #fbf8f8 46%,
          #f7f7f8 100%
        );
      overflow: hidden;
      isolation: isolate;
    }

    .section-transition::before {
      content: "";
      position: absolute;
      z-index: 1;
      top: -60px;
      left: -5%;
      width: 110%;
      height: 92px;
      border-radius: 0 0 50% 50%;
      background: #ffffff;
      transform: rotate(-1.1deg);
      transform-origin: center;
    }

    .section-transition::after {
      content: "";
      position: absolute;
      z-index: 0;
      width: 58%;
      height: 100px;
      left: 18%;
      bottom: -63px;
      border-radius: 50%;
      background:
        linear-gradient(
          90deg,
          rgba(255,79,139,.15),
          rgba(255,122,48,.11)
        );
      filter: blur(26px);
      animation: transitionDrift 8s ease-in-out infinite alternate;
    }

    @keyframes transitionDrift {
      from {
        transform: translateX(-8%) scaleX(.92);
        opacity: .55;
      }
      to {
        transform: translateX(12%) scaleX(1.12);
        opacity: .85;
      }
    }


    /* ==================================================
       CALCULATOR
    ================================================== */

    .calculator-section {
      width: 100%;
      padding: 0 24px 96px;
      background:
        radial-gradient(circle at 82% 0%, rgba(255,79,139,.055), transparent 24%),
        linear-gradient(180deg, #f7f7f8 0%, #ffffff 72%);
    }

    .calculator-shell {
      --mx: 76%;
      --my: 18%;
      position: relative;
      max-width: 1280px;
      margin: 0 auto;
      padding: clamp(64px, 7vw, 92px);
      display: grid;
      grid-template-columns: minmax(0,.82fr) minmax(480px,1.18fr);
      gap: clamp(58px, 7vw, 96px);
      align-items: center;
      border-radius: var(--radius-lg);
      background:
        radial-gradient(circle at var(--mx) var(--my), rgba(255,79,139,.18), transparent 28%),
        radial-gradient(circle at 72% 88%, rgba(255,122,48,.11), transparent 28%),
        linear-gradient(145deg, #1a1a21, #101015 58%, #17171c);
      box-shadow: 0 44px 98px rgba(25,25,35,.15);
      overflow: hidden;
    }

    .calculator-shell::before {
      content: "";
      position: absolute;
      width: 420px;
      height: 420px;
      top: -260px;
      right: -110px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,79,139,.14), transparent 68%);
      pointer-events: none;
    }

    .calculator-shell::after {
      content: "";
      position: absolute;
      width: 380px;
      height: 380px;
      left: -230px;
      bottom: -245px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,122,48,.08), transparent 70%);
      pointer-events: none;
    }

    .calculator-copy {
      position: relative;
      z-index: 2;
    }

    .calculator-shell .section-label {
      color: #ff82a7;
    }

    .calculator-copy h2 {
      margin: 0;
      max-width: 550px;
      color: #fff;
      font-size: clamp(2.9rem, 4.4vw, 4.55rem);
      line-height: .99;
      letter-spacing: -.065em;
    }

    .calculator-description {
      margin: 27px 0 0;
      max-width: 510px;
      color: rgba(255,255,255,.64);
      font-size: 1.02rem;
      line-height: 1.73;
    }

    .calculator-cta {
      margin-top: 32px;
    }


    /* ==================================================
       IMPACT CONTENT
    ================================================== */

    .impact-visual {
      position: relative;
      z-index: 2;
    }

    .impact-eyebrow {
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
      color: rgba(255,255,255,.4);
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .055em;
      text-transform: uppercase;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex: 0 0 auto;
      color: rgba(255,255,255,.45);
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: 0;
      text-transform: none;
    }

    .status::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--pink);
      box-shadow: 0 0 0 5px rgba(255,79,139,.09);
    }

    .impact-list {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .impact-list::before {
      content: "";
      position: absolute;
      top: 34px;
      bottom: 34px;
      left: 25px;
      width: 1px;
      background: linear-gradient(var(--pink), var(--orange));
      opacity: .42;
    }

    .impact-card {
      position: relative;
      min-height: 122px;
      padding: 21px 24px 21px 76px;
      border: 1px solid rgba(255,255,255,.085);
      border-radius: 20px;
      background:
        linear-gradient(
          135deg,
          rgba(255,255,255,.082),
          rgba(255,255,255,.035)
        );
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.045),
        0 18px 36px rgba(0,0,0,.1);
      backdrop-filter: blur(16px);
      overflow: hidden;
      transition:
        transform .3s ease,
        border-color .3s ease,
        background .3s ease;
    }

    .impact-card:nth-child(1) {
      margin-right: 30px;
    }

    .impact-card:nth-child(2) {
      margin-left: 18px;
      margin-right: 8px;
    }

    .impact-card:nth-child(3) {
      margin-left: 6px;
      margin-right: 24px;
    }

    .impact-card:nth-child(4) {
      margin-left: 24px;
    }

    .impact-card::after {
      content: "";
      position: absolute;
      width: 170px;
      height: 170px;
      right: -100px;
      top: -110px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255,79,139,.15), transparent 68%);
      opacity: 0;
      transition: opacity .3s ease;
      pointer-events: none;
    }

    .impact-card:hover {
      transform: translateX(7px);
      border-color: rgba(255,112,157,.22);
      background:
        linear-gradient(
          135deg,
          rgba(255,255,255,.11),
          rgba(255,255,255,.045)
        );
    }

    .impact-card:hover::after {
      opacity: 1;
    }

    .impact-number {
      position: absolute;
      top: 21px;
      left: 18px;
      width: 38px;
      height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255,100,145,.18);
      border-radius: 50%;
      background: rgba(255,79,139,.12);
      color: #ff94b3;
      font-size: .66rem;
      font-weight: 800;
      z-index: 2;
    }

    .impact-tag {
      display: block;
      margin-bottom: 6px;
      color: #ff84a7;
      font-size: .64rem;
      font-weight: 800;
      letter-spacing: .11em;
      text-transform: uppercase;
    }

    .impact-card h3 {
      margin: 0;
      color: #fff;
      font-size: 1.04rem;
      line-height: 1.3;
      letter-spacing: -.024em;
    }

    .impact-card p {
      margin: 6px 0 0;
      max-width: 435px;
      color: rgba(255,255,255,.51);
      font-size: .84rem;
      line-height: 1.5;
    }


    /* ==================================================
       TABLET
    ================================================== */

    @media (max-width: 1000px) {
      .hero-section {
        min-height: auto;
        padding-top: 142px;
      }

      .hero-container,
      .challenge-container,
      .calculator-shell {
        grid-template-columns: 1fr;
      }

      .hero-copy {
        max-width: 760px;
      }

      .hero-visual {
        max-width: 650px;
        margin: 14px auto 0;
      }

      .challenge-content {
        max-width: 700px;
      }

      .challenge-content::before {
        display: none;
      }

      .calculator-copy {
        max-width: 720px;
      }

      .impact-visual {
        max-width: 720px;
      }
    }


    /* ==================================================
       MOBILE
    ================================================== */

    @media (max-width: 680px) {
      .site-header {
        top: 14px;
      }

      .site-nav {
        width: calc(100% - 28px);
        min-height: 58px;
        padding: 8px 9px 8px 15px;
        border-radius: 18px;
      }

      .logo img {
        width: 118px;
      }

      .nav-button {
        padding: 11px 14px;
        font-size: .74rem;
      }

      .nav-button svg {
        display: none;
      }

      .hero-section {
        padding: 126px 20px 68px;
      }

      .hero-copy h1 {
        font-size: clamp(2.8rem, 13vw, 4rem);
      }

      .hero-description {
        font-size: 1rem;
        line-height: 1.65;
      }

      .hero-actions {
        align-items: flex-start;
        flex-direction: column;
      }

      .button {
        width: 100%;
      }

      .mockup-stage {
        transform: none;
        border-radius: 23px;
      }

      .mockup-stage img {
        border-radius: 17px;
      }

      .floating-note {
        position: relative;
        left: auto;
        bottom: auto;
        margin-top: 12px;
        max-width: none;
        animation: none;
      }

      .challenge-section {
        padding: 72px 20px 54px;
      }

      .challenge-number {
        top: 16px;
        right: 18px;
      }

      .challenge-container {
        gap: 38px;
      }

      .challenge-heading h2 {
        font-size: clamp(2.6rem, 12vw, 3.55rem);
      }

      .challenge-intro {
        font-size: 1rem;
      }

      .challenge-visual-wrap {
        width: calc(100% - 20px);
        margin-top: 38px;
      }

      .challenge-visual {
        padding: 6px;
        border-radius: 22px;
      }

      .challenge-visual img {
        border-radius: 17px;
      }

      .section-transition {
        height: 58px;
      }

      .calculator-section {
        padding: 0 14px 78px;
      }

      .calculator-shell {
        padding: 58px 21px;
        gap: 46px;
        border-radius: 28px;
      }

      .calculator-copy h2 {
        font-size: clamp(2.5rem, 11vw, 3.45rem);
      }

      .calculator-description {
        font-size: 1rem;
      }

      .impact-eyebrow {
        align-items: flex-start;
        flex-direction: column;
        line-height: 1.45;
      }

      .status {
        display: none;
      }

      .impact-list::before {
        display: none;
      }

      .impact-card,
      .impact-card:nth-child(1),
      .impact-card:nth-child(2),
      .impact-card:nth-child(3),
      .impact-card:nth-child(4) {
        margin: 0;
        min-height: auto;
        padding: 68px 20px 20px;
      }

      .impact-number {
