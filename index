<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>FlowCRM | Calculadora de ROI para Automação de Marketing</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <style>

    /* ==================================================
       DESIGN SYSTEM
    ================================================== */

    :root {
      --pink: #ff4f8b;
      --orange: #ff7a30;

      --ink: #191923;
      --ink-soft: #4f4f5f;

      --cream: #fff9f6;
      --white: #ffffff;

      --dark: #111116;
      --dark-soft: #18181f;

      --border: rgba(25, 25, 35, 0.08);

      --gradient:
        linear-gradient(
          135deg,
          var(--pink) 0%,
          var(--orange) 100%
        );

      --container: 1180px;

      --radius-lg: 42px;
      --radius-md: 24px;
      --radius-sm: 16px;
    }


    /* ==================================================
       RESET
    ================================================== */

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;

      font-family:
        "Manrope",
        Arial,
        sans-serif;

      background: var(--white);

      color: var(--ink);

      overflow-x: hidden;
    }

    img {
      display: block;
      max-width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input {
      font: inherit;
    }


    /* ==================================================
       UTILITÁRIOS
    ================================================== */

    .container {
      width: min(
        var(--container),
        calc(100% - 48px)
      );

      margin-inline: auto;
    }


    .gradient-text {
      background: var(--gradient);

      -webkit-background-clip: text;
      background-clip: text;

      color: transparent;
    }


    .section-label {
      display: inline-flex;
      align-items: center;

      gap: 11px;

      margin-bottom: 26px;

      color: var(--pink);

      font-size: 0.75rem;
      font-weight: 800;

      letter-spacing: 0.14em;

      text-transform: uppercase;
    }


    .section-label::before {
      content: "";

      width: 28px;
      height: 2px;

      border-radius: 100px;

      background: var(--gradient);
    }


    /* ==================================================
       REVEAL
    ================================================== */

    .reveal {
      opacity: 0;

      transform:
        translateY(28px);

      transition:
        opacity 0.8s ease,
        transform 0.8s
        cubic-bezier(.2,.8,.2,1);
    }


    .reveal.is-visible {
      opacity: 1;

      transform:
        translateY(0);
    }


    .delay-1 {
      transition-delay: 0.08s;
    }

    .delay-2 {
      transition-delay: 0.16s;
    }

    .delay-3 {
      transition-delay: 0.24s;
    }


    /* ==================================================
       NAV
    ================================================== */

    .site-header {
      position: absolute;

      top: 22px;
      left: 0;

      width: 100%;

      z-index: 20;
    }


    .site-nav {
      width: min(
        1180px,
        calc(100% - 48px)
      );

      margin: 0 auto;

      min-height: 66px;

      padding:
        10px
        12px
        10px
        20px;

      display: flex;

      align-items: center;
      justify-content: space-between;

      gap: 24px;

      border:
        1px solid
        rgba(255,255,255,.72);

      border-radius: 22px;

      background:
        rgba(255,255,255,.72);

      box-shadow:
        0 16px 50px
        rgba(25,25,35,.07);

      backdrop-filter:
        blur(18px);
    }


    .logo {
      display: flex;

      align-items: center;
    }


    .logo img {
      width: 142px;
    }


    /* ==================================================
       BUTTON
    ================================================== */

    .button {
      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 10px;

      min-height: 54px;

      padding:
        17px
        26px;

      border-radius: 999px;

      background: var(--gradient);

      color: white;

      font-size: .93rem;
      font-weight: 800;

      box-shadow:
        0 16px 38px
        rgba(255,79,139,.21);

      transition:
        transform .25s ease,
        box-shadow .25s ease;
    }


    .button svg {
      width: 18px;
      height: 18px;

      transition:
        transform .25s ease;
    }


    .button:hover {
      transform:
        translateY(-3px);

      box-shadow:
        0 24px 54px
        rgba(255,79,139,.31);
    }


    .button:hover svg {
      transform:
        translateX(4px);
    }


    .nav-button {
      min-height: 44px;

      padding:
        13px
        19px;

      font-size: .82rem;

      box-shadow:
        0 10px 28px
        rgba(255,79,139,.18);
    }


    /* ==================================================
       HERO
    ================================================== */

    .hero-section {
      position: relative;

      min-height: 100svh;

      padding:
        166px
        24px
        132px;

      display: flex;

      align-items: center;

      background:
        linear-gradient(
          180deg,
          #fff7f3 0%,
          #ffffff 88%
        );

      overflow: hidden;
    }


    /* orb rosa */

    .hero-section::before {
      content: "";

      position: absolute;

      width: 700px;
      height: 700px;

      top: -330px;
      right: -180px;

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(255,79,139,.22),
          rgba(255,79,139,.05) 42%,
          transparent 70%
        );

      animation:
        heroOrb 11s
        ease-in-out
        infinite alternate;

      pointer-events: none;
    }


    /* orb laranja */

    .hero-section::after {
      content: "";

      position: absolute;

      width: 540px;
      height: 540px;

      left: -300px;
      bottom: -200px;

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(255,122,48,.12),
          transparent 68%
        );

      pointer-events: none;
    }


    @keyframes heroOrb {

      from {
        transform:
          translate3d(0,0,0)
          scale(1);
      }

      to {
        transform:
          translate3d(-35px,40px,0)
          scale(1.07);
      }
    }


    .hero-container {
      position: relative;

      z-index: 2;

      max-width: var(--container);

      width: 100%;

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        minmax(0, 1.06fr)
        minmax(390px, .94fr);

      gap:
        clamp(
          60px,
          8vw,
          100px
        );

      align-items: center;
    }


    /* HERO COPY */

    .hero-copy {
      max-width: 675px;
    }


    .hero-eyebrow {
      display: inline-flex;

      align-items: center;

      gap: 9px;

      padding:
        9px
        13px;

      margin-bottom: 24px;

      border:
        1px solid
        rgba(255,79,139,.13);

      border-radius: 999px;

      background:
        rgba(255,255,255,.67);

      box-shadow:
        0 10px 28px
        rgba(25,25,35,.045);

      color: #666675;

      font-size: .77rem;
      font-weight: 700;
    }


    .hero-eyebrow::before {
      content: "";

      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: var(--pink);

      box-shadow:
        0 0 0 5px
        rgba(255,79,139,.09);
    }


    .hero-copy h1 {
      margin: 0;

      max-width: 700px;

      font-size:
        clamp(
          3.4rem,
          6vw,
          5.8rem
        );

      line-height: .94;

      letter-spacing:
        -.075em;

      color: var(--ink);
    }


    .hero-copy h1 span {
      display: inline;
    }


    .hero-description {
      margin:
        28px
        0
        0;

      max-width: 570px;

      color:
        var(--ink-soft);

      font-size:
        clamp(
          1.02rem,
          1.6vw,
          1.16rem
        );

      line-height: 1.72;
    }


    .hero-actions {
      margin-top: 34px;

      display: flex;

      align-items: center;

      gap: 20px;

      flex-wrap: wrap;
    }


    .hero-note {
      max-width: 245px;

      color: #777783;

      font-size: .78rem;

      line-height: 1.55;
    }


    /* ==================================================
       HERO VISUAL
    ================================================== */

    .hero-visual {
      position: relative;

      perspective: 1200px;
    }


    .mockup-stage {
      position: relative;

      padding: 10px;

      border:
        1px solid
        rgba(255,255,255,.9);

      border-radius: 30px;

      background:
        rgba(255,255,255,.6);

      box-shadow:
        0 40px 100px
        rgba(25,25,35,.16);

      backdrop-filter:
        blur(20px);

      transform:
        perspective(1200px)
        rotateY(-5deg)
        rotateX(2deg);

      transition:
        transform
        .5s
        cubic-bezier(.2,.8,.2,1);
    }


    .hero-visual:hover
    .mockup-stage {
      transform:
        perspective(1200px)
        rotateY(-1deg)
        rotateX(0deg)
        translateY(-6px);
    }


    .mockup-stage img {
      width: 100%;

      border-radius: 22px;
    }


    .mockup-stage::before {
      content: "";

      position: absolute;

      inset: -38px;

      z-index: -1;

      border-radius: 50px;

      background:
        linear-gradient(
          135deg,
          rgba(255,79,139,.18),
          rgba(255,122,48,.10)
        );

      filter:
        blur(35px);

      opacity: .72;
    }


    .floating-note {
      position: absolute;

      left: -36px;
      bottom: -30px;

      max-width: 205px;

      padding:
        15px
        17px;

      border:
        1px solid
        rgba(255,255,255,.84);

      border-radius: 18px;

      background:
        rgba(255,255,255,.83);

      box-shadow:
        0 20px 55px
        rgba(25,25,35,.12);

      backdrop-filter:
        blur(16px);

      color: #575765;

      font-size: .78rem;

      line-height: 1.45;

      animation:
        floatNote
        4.5s
        ease-in-out
        infinite alternate;
    }


    .floating-note strong {
      display: block;

      margin-bottom: 3px;

      color: var(--ink);

      font-size: .82rem;
    }


    @keyframes floatNote {

      to {
        transform:
          translateY(-9px);
      }
    }


    /* ==================================================
       CHALLENGE
    ================================================== */

    .challenge-section {
      position: relative;

      padding:
        clamp(
          120px,
          13vw,
          180px
        )
        24px;

      background:
        var(--white);

      overflow: hidden;
    }


    .challenge-number {
      position: absolute;

      top: 52px;
      right:
        max(
          24px,
          calc(
            (100vw - 1180px) / 2
          )
        );

      color:
        rgba(25,25,35,.026);

      font-size:
        clamp(
          8rem,
          18vw,
          17rem
        );

      font-weight: 800;

      line-height: 1;

      letter-spacing:
        -.08em;

      pointer-events: none;
    }


    .challenge-container {
      position: relative;

      z-index: 2;

      max-width:
        var(--container);

      margin: 0 auto;

      display: grid;

      grid-template-columns:
        minmax(0,1.07fr)
        minmax(390px,.93fr);

      gap:
        clamp(
          72px,
          10vw,
          130px
        );

      align-items: center;
    }


    .challenge-heading h2 {
      margin: 0;

      max-width: 700px;

      font-size:
        clamp(
          3rem,
          5vw,
          5rem
        );

      line-height: .99;

      letter-spacing:
        -.065em;
    }


    .challenge-content {
      position: relative;
    }


    .challenge-content::before {
      content: "";

      position: absolute;

      top: 0;
      left: -34px;

      width: 1px;
      height: 100%;

      background:
        linear-gradient(
          180deg,
          var(--pink),
          rgba(255,122,48,.12)
        );
    }


    .challenge-intro {
      margin: 0;

      color: #555563;

      font-size: 1.08rem;

      line-height: 1.82;
    }


    .challenge-conclusion {
      margin:
        34px
        0
        0;

      padding-top: 29px;

      border-top:
        1px solid
        rgba(25,25,35,.08);

      color: var(--ink);

      font-size: 1.05rem;

      font-weight: 700;

      line-height: 1.65;
    }


    /* ==================================================
       TRANSITION
    ================================================== */

    .section-transition {
      height: 88px;

      background:
        linear-gradient(
          180deg,
          #ffffff,
          #fafafa
        );
    }


    /* ==================================================
       CALCULATOR
    ================================================== */

    .calculator-section {
      width: 100%;

      padding:
        24px
        24px
        130px;

      background:
        linear-gradient(
          180deg,
          #fafafa 0%,
          #ffffff 100%
        );
    }


    .calculator-shell {
      --mx: 75%;
      --my: 20%;

      position: relative;

      max-width: 1280px;

      margin: 0 auto;

      padding:
        clamp(
          72px,
          8vw,
          108px
        );

      display: grid;

      grid-template-columns:
        minmax(0,.84fr)
        minmax(470px,1.16fr);

      gap:
        clamp(
          72px,
          9vw,
          124px
        );

      align-items: center;

      border-radius:
        var(--radius-lg);

      background:
        radial-gradient(
          circle at var(--mx) var(--my),
          rgba(255,79,139,.18),
          transparent 28%
        ),
        radial-gradient(
          circle at 72% 88%,
          rgba(255,122,48,.11),
          transparent 28%
        ),
        linear-gradient(
          145deg,
          #1a1a21,
          #101015 58%,
          #17171c
        );

      box-shadow:
        0 50px 110px
        rgba(25,25,35,.15);

      overflow: hidden;
    }


    .calculator-copy {
      position: relative;

      z-index: 2;
    }


    .calculator-shell
    .section-label {
      color: #ff82a7;
    }


    .calculator-copy h2 {
      margin: 0;

      max-width: 550px;

      color: white;

      font-size:
        clamp(
          2.9rem,
          4.5vw,
          4.7rem
        );

      line-height: .99;

      letter-spacing:
        -.065em;
    }


    .calculator-description {
      margin:
        29px
        0
        0;

      max-width: 510px;

      color:
        rgba(255,255,255,.64);

      font-size: 1.04rem;

      line-height: 1.76;
    }


    .calculator-cta {
      margin-top: 36px;
    }


    /* ==================================================
       IMPACT VISUAL
    ================================================== */

    .impact-visual {
      position: relative;

      z-index: 2;
    }


    .impact-eyebrow {
      margin-bottom: 24px;

      display: flex;

      align-items: center;
      justify-content: space-between;

      gap: 20px;

      color:
        rgba(255,255,255,.38);

      font-size: .72rem;

      font-weight: 800;

      letter-spacing: .1em;

      text-transform: uppercase;
    }


    .status {
      display: inline-flex;

      align-items: center;

      gap: 8px;

      color:
        rgba(255,255,255,.45);

      font-size: .72rem;

      font-weight: 600;

      letter-spacing: 0;

      text-transform: none;
    }


    .status::before {
      content: "";

      width: 7px;
      height: 7px;

      border-radius: 50%;

      background: var(--pink);

      box-shadow:
        0 0 0 5px
        rgba(255,79,139,.09);
    }


    .impact-list {
      position: relative;

      display: flex;

      flex-direction: column;

      gap: 14px;
    }


    .impact-list::before {
      content: "";

      position: absolute;

      top: 35px;
      bottom: 35px;

      left: 26px;

      width: 1px;

      background:
        linear-gradient(
          var(--pink),
          var(--orange)
        );

      opacity: .42;
    }


    .impact-card {
      position: relative;

      min-height: 138px;

      padding:
        25px
        27px
        25px
        82px;

      border:
        1px solid
        rgba(255,255,255,.085);

      border-radius: 22px;

      background:
        linear-gradient(
          135deg,
          rgba(255,255,255,.082),
          rgba(255,255,255,.035)
        );

      box-shadow:
        inset 0 1px 0
        rgba(255,255,255,.045),
        0 20px 40px
        rgba(0,0,0,.11);

      backdrop-filter:
        blur(16px);

      transition:
        transform .3s ease,
        border-color .3s ease,
        background .3s ease;
    }


    .impact-card:nth-child(1) {
      margin-right: 30px;
    }


    .impact-card:nth-child(2) {
      margin-left: 28px;
    }


    .impact-card:nth-child(3) {
      margin-right: 14px;
    }


    .impact-card:hover {
      transform:
        translateX(7px);

      border-color:
        rgba(255,112,157,.22);

      background:
        linear-gradient(
          135deg,
          rgba(255,255,255,.11),
          rgba(255,255,255,.045)
        );
    }


    .impact-number {
      position: absolute;

      top: 25px;
      left: 20px;

      width: 40px;
      height: 40px;

      display: flex;

      align-items: center;
      justify-content: center;

      border:
        1px solid
        rgba(255,100,145,.18);

      border-radius: 50%;

      background:
        rgba(255,79,139,.12);

      color: #ff94b3;

      font-size: .68rem;

      font-weight: 800;

      z-index: 2;
    }


    .impact-tag {
      display: block;

      margin-bottom: 8px;

      color: #ff84a7;

      font-size: .66rem;

      font-weight: 800;

      letter-spacing: .11em;

      text-transform: uppercase;
    }


    .impact-card h3 {
      margin: 0;

      color: white;

      font-size: 1.1rem;

      line-height: 1.3;

      letter-spacing: -.025em;
    }


    .impact-card p {
      margin:
        7px
        0
        0;

      max-width: 420px;

      color:
        rgba(255,255,255,.51);

      font-size: .88rem;

      line-height: 1.56;
    }


    /* ==================================================
       TABLET
    ================================================== */

    @media (max-width: 1000px) {

      .hero-section {
        min-height: auto;

        padding-top: 150px;
      }


      .hero-container,
      .challenge-container,
      .calculator-shell {
        grid-template-columns:
          1fr;
      }


      .hero-copy {
        max-width: 760px;
      }


      .hero-visual {
        max-width: 660px;

        margin: 20px auto 0;
      }


      .challenge-content {
        max-width: 700px;
      }


      .challenge-content::before {
        display: none;
      }


      .calculator-copy {
        max-width: 720px;
      }


      .impact-visual {
        max-width: 720px;
      }
    }


    /* ==================================================
       MOBILE
    ================================================== */

    @media (max-width: 680px) {

      .container {
        width:
          calc(100% - 40px);
      }


      .site-header {
        top: 14px;
      }


      .site-nav {
        width:
          calc(100% - 28px);

        min-height: 58px;

        padding:
          8px
          9px
          8px
          15px;

        border-radius: 18px;
      }


      .logo img {
        width: 118px;
      }


      .nav-button {
        padding:
          11px
          14px;

        font-size: .74rem;
      }


      .nav-button svg {
        display: none;
      }


      .hero-section {
        padding:
          132px
          20px
          88px;
      }


      .hero-copy h1 {
        font-size:
          clamp(
            2.85rem,
            13vw,
            4rem
          );

        line-height: .96;
      }


      .hero-description {
        font-size: 1rem;

        line-height: 1.66;
      }


      .hero-actions {
        align-items:
          flex-start;

        flex-direction:
          column;
      }


      .button {
        width: 100%;
      }


      .hero-note {
        max-width: none;
      }


      .mockup-stage {
        transform: none;

        border-radius: 23px;
      }


      .mockup-stage img {
        border-radius: 17px;
      }


      .floating-note {
        position: relative;

        left: auto;
        bottom: auto;

        margin-top: 13px;

        max-width: none;

        animation: none;
      }


      .challenge-section {
        padding:
          100px
          20px;
      }


      .challenge-number {
        top: 38px;
        right: 18px;
      }


      .challenge-heading h2 {
        font-size:
          clamp(
            2.65rem,
            12vw,
            3.6rem
          );
      }


      .challenge-intro {
        font-size: 1rem;
      }


      .section-transition {
        height: 48px;
      }


      .calculator-section {
        padding:
          14px
          14px
          90px;
      }


      .calculator-shell {
        padding:
          66px
          22px;

        gap: 54px;

        border-radius: 28px;
      }


      .calculator-copy h2 {
        font-size:
          clamp(
            2.55rem,
            11vw,
            3.5rem
          );
      }


      .calculator-description {
        font-size: 1rem;
      }


      .impact-eyebrow {
        align-items:
          flex-start;

        flex-direction:
          column;
      }


      .status {
        display: none;
      }


      .impact-list::before {
        display: none;
      }


      .impact-card,
      .impact-card:nth-child(1),
      .impact-card:nth-child(2),
      .impact-card:nth-child(3) {
        margin: 0;

        min-height: auto;

        padding:
          72px
          21px
          22px;
      }


      .impact-number {
        top: 20px;
        left: 20px;
      }
    }


    /* ==================================================
       REDUCED MOTION
    ================================================== */

    @media
    (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation: none !important;

        transition:
          none !important;
